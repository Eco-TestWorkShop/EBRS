# ============================================
#  ECOWHEEL — FULL ENVIRONMENT CONFIGURATION
# ============================================

# -------------------- DATABASE --------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=apple    
POSTGRES_DB=ecowheel

# Connection Strings
DATABASE_URL=postgresql://postgres:apple@localhost:5432/ecowheel
DATABASE_URL_DEV=postgresql://postgres:apple@localhost:5432/ecowheel
DATABASE_URL_PROD=postgresql://postgres:YOUR_PROD_DB_USER:YOUR_PROD_DB_PASSWORD@your-prod-host:5432/your_prod_db   # 🔴 ADD YOUR PROD URL

# -------------------- JWT SECURITY --------------------
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_abcdef1234567890
JWT_SIGNATURE=CHANGE_THIS_TO_ANOTHER_RANDOM_STRING_0987654321fedcba

# -------------------- SERVER & CORS --------------------
API_PORT=3300
CORS_ALLOW_URL=http://localhost:5173,http://localhost:3002

# -------------------- BASE URLs --------------------
# Frontend
BASE_URL_LOCAL=http://localhost:5173
BASE_URL_DEV=https://dev.EcoWheel.me
BASE_URL_PROD=https://EcoWheel.me

# Backend API
BASE_URL_API_LOCAL=http://localhost:3300

# -------------------- GOOGLE OAUTH --------------------
CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com    # 🔴 ADD YOUR REAL ID
CLIENT_SECRET=your_google_client_secret_here                      # 🔴 ADD YOUR REAL SECRET

# -------------------- EMAIL (SMTP) --------------------
EMAIL_USERNAME=your_email@example.com                             # 🔴 ADD YOUR EMAIL
EMAIL_PASSWORD=your_email_app_password_or_regular_password        # 🔴 ADD YOUR PASSWORD

# -------------------- PAYPAL --------------------
PAYPAL_CLIENT_ID=your_paypal_client_id_here                      # 🔴 ADD YOUR CLIENT ID
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here              # 🔴 ADD YOUR SECRET

# -------------------- ENVIRONMENT MODES --------------------
NODE_ENV=local          # Options: local | dev | prod
DB_MODE=dev             # Options: local | dev | prod
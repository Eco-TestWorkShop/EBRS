# ============================================================
# BACKEND DATABASE (server‑side only)
# ============================================================
# Not prefixed with VITE_ → stays on the server.
# Used only in your backend code (e.g., Prisma, Knex, etc.)
DATABASE_URL=postgresql://postgres:apple@localhost:5432/ecowheel

# ============================================================
# FRONTEND API BASE URL (exposed to the browser)
# ============================================================
# Prefixed with VITE_ → available via import.meta.env.VITE_BACK_END_LOCAL
# Used for the dev server proxy and directly in your frontend code.
VITE_BACK_END_LOCAL=http://localhost:3300/api/v1/

# ============================================================
# APPLICATION MODE
# ============================================================
# Access via import.meta.env.VITE_MODE
# Typical values: "local", "dev", "prod"
VITE_MODE=local

# ============================================================
# VITE DEV SERVER SETTINGS (optional)
# ============================================================
# VITE_DEV_PORT – port for the Vite dev server (default: 3000)
VITE_DEV_PORT=5173

# VITE_DEV_HOST – host to listen on (default: 'localhost')
# VITE_DEV_HOST=0.0.0.0

# VITE_DEV_HTTPS – enable HTTPS (default: false)
# VITE_DEV_HTTPS=true

# VITE_DEV_OPEN – open browser on start (default: false)
# VITE_DEV_OPEN=true

# ============================================================
# BUILD & PERFORMANCE OPTIONS (optional)
# ============================================================
# VITE_MINIFY – enable minification (default: true)
# VITE_MINIFY=true

# VITE_ANALYZE_BUNDLE – enable bundle analysis (default: false)
# VITE_ANALYZE_BUNDLE=false